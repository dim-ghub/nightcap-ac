{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_VOX_TTS_overlay",
    "type": "GLOBAL",
    "library_path": "@LIB@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "Vox TTS in-game menu",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": {
      "VOX_TTS_LAYER": "1",
